# The micro-VM sandbox for actors that get a passthrough GPU.
#
# Only the guest differs from the stock "microvm" config: cloud-hypervisor and
# virtiofsd are guest-agnostic and are the same binaries. The guest swap is not
# just a different rootfs -- NVIDIA's guest is EROFS where the stock one is ext4,
# and it needs PCI reallocation parameters the stock guest never wanted -- so the
# kata-config is swapped too. ateom reads rootfs_type from it to build the root=
# / rootflags= / rootfstype= parameters, and passes its kernel_params through.
#
# amd64 only: NVIDIA publishes this guest for x86_64.
#
# Produce all three GPU assets with hack/microvm-assets/assemble-gpu.sh, stage
# them into the bucket, and paste the sha256 sums it prints.

apiVersion: ate.dev/v1alpha1
kind: SandboxConfig
metadata:
  name: microvm-gpu
spec:
  sandboxClass: microvm
  assets:
    amd64:
      # Guest-agnostic, shared with the stock microvm config.
      cloud-hypervisor:
        url: "gs://${BUCKET_NAME}/kata-assets/cloud-hypervisor"
        sha256: "829af01ff075bb96c4f183905134c453a88d68cbabdc6b87df21098842581ee9"
      virtiofsd:
        url: "gs://${BUCKET_NAME}/kata-assets/virtiofsd"
        # The upstream x86_64-musl v1.14.0 binary, so it pins like the stock
        # config does rather than being read out of whatever SandboxConfig
        # happens to be in the cluster -- a stale one there is indistinguishable
        # from a correct one until the guest fails to boot.
        sha256: "15b2e72a78cc08a9bd8a6943e89fb69c88cb3cbeb63069efceade835342ac7d4"
      # NVIDIA's GPU guest: the driver and NVRC's bring-up are baked in. NVRC
      # generates the guest CDI spec at boot, which is what lets the kata-agent
      # inject /dev/nvidia* into the actor container.
      kata-kernel:
        url: "gs://${BUCKET_NAME}/kata-gpu-assets/vmlinux-gpu"
        sha256: "${GPU_KERNEL_SHA256}"
      kata-image:
        url: "gs://${BUCKET_NAME}/kata-gpu-assets/rootfs-gpu.img"
        sha256: "${GPU_ROOTFS_SHA256}"
      # Derived by assemble-gpu.sh: upstream ships no clh flavour of its GPU
      # config, because kata's own GPU support is QEMU-only.
      kata-config:
        url: "gs://${BUCKET_NAME}/kata-gpu-assets/configuration-clh-gpu.toml"
        sha256: "${GPU_CONFIG_SHA256}"
