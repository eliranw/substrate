      "groupIds": [], "boundElements": null, "link": null, "locked": false },
    { "type": "text", "id": "c2_t4", "x": 708, "y": 462, "width": 420, "height": 22,
      "text": "vfio-pci   +   IOMMU", "originalText": "vfio-pci   +   IOMMU",
      "fontSize": 17, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#c2410c", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 100051, "version": 1, "versionNonce": 100052, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "c2_t4d", "x": 708, "y": 488, "width": 420, "height": 36,
      "text": "this is VFIO: a host driver that claims the card\nso that nothing on the host can drive it",
      "originalText": "this is VFIO: a host driver that claims the card\nso that nothing on the host can drive it",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 100053, "version": 1, "versionNonce": 100054, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

