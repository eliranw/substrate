    { "type": "text", "id": "c2_t3d", "x": 708, "y": 425, "width": 480, "height": 18,
      "text": "the VM is an ordinary process on the host",
      "originalText": "the VM is an ordinary process on the host",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
