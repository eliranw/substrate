    { "type": "text", "id": "c1_foot", "x": 120, "y": 632, "width": 460, "height": 36,
      "text": "One driver, one card.\nNothing virtual in the path.",
      "originalText": "One driver, one card.\nNothing virtual in the path.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 100079, "version": 1, "versionNonce": 100080, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "iommu_note", "x": 660, "y": 632, "width": 1010, "height": 54,
      "text": "The IOMMU is a page table for devices. Without one, a card handed to a VM could write anywhere in host memory.\nWith one, the card reaches only the pages belonging to that single VM — which is what makes it safe to give real\nhardware to untrusted code. It is also why the guest sees a genuine NVIDIA GPU rather than an emulated one.",
      "originalText": "The IOMMU is a page table for devices. Without one, a card handed to a VM could write anywhere in host memory.\nWith one, the card reaches only the pages belonging to that single VM — which is what makes it safe to give real\nhardware to untrusted code. It is also why the guest sees a genuine NVIDIA GPU rather than an emulated one.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 100081, "version": 1, "versionNonce": 100082, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

