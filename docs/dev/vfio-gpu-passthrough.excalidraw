      "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "c3_t1d", "x": 1248, "y": 310, "width": 500, "height": 36,
      "text": "guest RAM and vCPU registers only.\nNo GPU state — none of it is readable.",
