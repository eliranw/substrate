    { "type": "text", "id": "actor_t", "x": 1406, "y": 806, "width": 328, "height": 122,
      "text": "ACTOR CONTAINER\n\nyour image, unmodified\n\n/dev/nvidia0\n/dev/nvidiactl\nnvidia-smi works here",
      "originalText": "ACTOR CONTAINER\n\nyour image, unmodified\n\n/dev/nvidia0\n/dev/nvidiactl\nnvidia-smi works here",
