      "groupIds": [], "boundElements": null, "link": null, "locked": false },
    { "type": "text", "id": "gu_t2", "x": 640, "y": 867, "width": 700, "height": 20,
      "text": "kata-agent   ·   stock, unmodified",
      "originalText": "kata-agent   ·   stock, unmodified",
      "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 600021, "version": 1, "versionNonce": 600022, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "gu_t2d", "x": 640, "y": 891, "width": 720, "height": 54,
      "text": "ttrpc over hybrid-vsock. On CreateContainer it reads the\ncdi.k8s.io/ annotation and injects the device nodes, the\ndriver libraries and the device-cgroup entries.",
      "originalText": "ttrpc over hybrid-vsock. On CreateContainer it reads the\ncdi.k8s.io/ annotation and injects the device nodes, the\ndriver libraries and the device-cgroup entries.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 600023, "version": 1, "versionNonce": 600024, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

