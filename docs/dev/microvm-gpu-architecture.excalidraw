    { "type": "text", "id": "clh_d", "x": 200, "y": 778, "width": 340, "height": 90,
      "text": "a child process of ateom,\nplus virtiofsd × 1–2 for the\nrootfs and durable dirs.\nDriven over its REST socket:\nvm.create / snapshot / restore\nvm.add-device / remove-device",
      "originalText": "a child process of ateom,\nplus virtiofsd × 1–2 for the\nrootfs and durable dirs.\nDriven over its REST socket:\nvm.create / snapshot / restore\nvm.add-device / remove-device",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 500063, "version": 1, "versionNonce": 500064, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

