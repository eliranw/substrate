# A micro-VM actor with a passthrough GPU, suspended and resumed.
#
# The workload is a CUDA base image rather than one of the in-memory demo apps,
# and that is the point of the fixture: an actor that never opens the device
# passes every step below while the GPU is entirely unusable. nvidia-smi inside
# the actor is the load-bearing assertion, not the actor reaching Ready.
#
# Prereqs (see docs/.../microvm-gpu-e2e.md for the full runbook):
#   - a GPU node with IOMMU on and the GPU Operator in vm-passthrough mode, so
#     the GPU is bound to vfio-pci and the sandbox device plugin advertises it
#   - the GPU assets staged and the microvm-gpu SandboxConfig applied
#
# NB: in vm-passthrough mode the advertised resource is MODEL-SPECIFIC
# (nvidia.com/<PCI_MODEL>), NOT nvidia.com/gpu. It changes with the card: an
# A100 host advertises nvidia.com/GA100_A100_PCIE_40GB, a T4 host
# nvidia.com/TU104GL_TESLA_T4. Read the live name off the node:
#   kubectl get node -o jsonpath='{.status.allocatable}' | tr ',' '\n' | grep nvidia

apiVersion: v1
kind: Namespace
metadata:
  name: ate-demo-gpu-microvm

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: gpu-microvm
  namespace: ate-demo-gpu-microvm
  labels:
    workload: gpu-microvm
spec:
  # One replica, one GPU. ateom hands the actor's VM every device the pod was
  # granted, and one actor runs per worker, so the pod's allocation IS the
  # actor's allocation.
  replicas: 1
  sandboxClass: microvm
  sandboxConfigName: microvm-gpu
  ateomImage: ko://github.com/agent-substrate/substrate/cmd/ateom-microvm
  template:
    resources:
      requests:
        nvidia.com/GA100_A100_PCIE_40GB: "1"
      limits:
        nvidia.com/GA100_A100_PCIE_40GB: "1"

---

apiVersion: ate.dev/v1alpha1
kind: ActorTemplate
metadata:
  name: gpu-microvm
  namespace: ate-demo-gpu-microvm
spec:
  sandboxClass: microvm
  containers:
  - name: cuda
    # A CUDA base image carries the driver userspace (nvidia-smi, libcuda), so
    # the container can actually open the device. The guest supplies the kernel
    # driver; the kata-agent injects the device nodes and libraries from the CDI
    # spec NVRC generated at boot.
    #
    # Pinned by digest because ActorTemplate rejects any image without one: a
    # tag that moves under a snapshot would restore a guest whose rootfs no
    # longer matches its image.
    image: nvcr.io/nvidia/cuda:12.6.2-base-ubuntu24.04@sha256:631ec7090c36ab846cf021073ff4a64fb9cffa90b4f9f0083799288c607073ce
    # The workload polls the GPU and prints what it finds, because that is the
    # only way to observe it: there is no exec into an actor, and the guest has
    # no shell. ateom forwards container stdout into the worker pod's log, and
    # re-attaches that forwarding after a restore, so one `kubectl logs` covers
    # the whole cycle -- the gap while suspended and the lines that follow it.
    #
    # stat prints each node's major:minor. Those are the numbers a broken
    # re-attach would change while nvidia-smi still worked, so they are logged
    # alongside rather than checked separately.
    command:
    - /bin/sh
    - -c
    - |
      while :; do
        date -Is
        stat -c '%n %t:%T' /dev/nvidia* 2>&1
        nvidia-smi --query-gpu=name,driver_version --format=csv,noheader || echo 'nvidia-smi FAILED'
        sleep 5
      done
    # No readyz: this image serves no HTTP. Readiness here would only prove the
    # container started, which is exactly the false signal the fixture avoids --
    # the GPU checks in the runbook are the real assertion.
  workerSelector:
    matchLabels:
      workload: gpu-microvm
  snapshotsConfig:
    # Full on pause: the GPU is detached before the guest is frozen and
    # re-attached on resume, so a GPU actor snapshots like any other.
    onPause: Full
    location: gs://${BUCKET_NAME}/ate-demo-gpu-microvm/
