      QIMHjQSOA48CAlgOCAAAABAAAADMAAAA6Pnf/wIAAAAAAAAAAAAAAP//////////AAAAAAAAAAD//////////wAAAAAAAAAA
      AQAAAAAAAAABAAAAAAAAAAEAAAAAAAAATQAAAAAAAAAMAAAAAAAAAEgFQAAAAAAADQAAAAAAAABkCEAAAAAAAAQAAAAAAAAA
      eAJAAAAAAAAFAAAAAAAAAOADQAAAAAAABgAAAAAAAADAAkAAAAAAAAoAAAAAAAAAmwAAAAAAAAALAAAAAAAAABgAAAAAAAAA
      FQAAAAAAAAAAAAAAAAAAAAMAAAAAAAAAABBgAAAAAAACAAAAAAAAAGAAAAAAAAAAFAAAAAAAAAAHAAAAAAAAABcAAAAAAAAA
      6ARAAAAAAAAHAAAAAAAAALgEQAAAAAAACAAAAAAAAAAwAAAAAAAAAAkAAAAAAAAAGAAAAAAAAAD+//9vAAAAAJgEQAAAAAAA
      ////bwAAAAABAAAAAAAAAPD//28AAAAAfARAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
      AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAFgOYAAAAAAA
      AAAAAAAAAAAAAAAAAAAAAHYFQAAAAAAAhgVAAAAAAACWBUAAAAAAAKYFQAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAuc2hzdHJ0
      YWIALmludGVycAAubm90ZS5BQkktdGFnAC5oYXNoAC5keW5zeW0ALmR5bnN0cgAuZ251LnZlcnNpb24ALmdudS52ZXJzaW9u
      X3IALnJlbGEuZHluAC5yZWxhLnBsdAAuaW5pdAAudGV4dAAuZmluaQAucm9kYXRhAC5laF9mcmFtZV9oZHIALmVoX2ZyYW1l
      AC5jdG9ycwAuZHRvcnMALmR5bmFtaWMALmdvdAAuZ290LnBsdAAuZGF0YQAuYnNzAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
      AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAACwAAAAEAAAACAAAAAAAAADgCQAAAAAAA
      OAIAAAAAAAAcAAAAAAAAAAAAAAAAAAAAAQAAAAAAAAAAAAAAAAAAABMAAAAHAAAAAgAAAAAAAABUAkAAAAAAAFQCAAAAAAAA
      IAAAAAAAAAAAAAAAAAAAAAQAAAAAAAAAAAAAAAAAAAAhAAAABQAAAAIAAAAAAAAAeAJAAAAAAAB4AgAAAAAAAEQAAAAAAAAA
      BAAAAAAAAAAIAAAAAAAAAAQAAAAAAAAAJwAAAAsAAAACAAAAAAAAAMACQAAAAAAAwAIAAAAAAAAgAQAAAAAAAAUAAAABAAAA
      CAAAAAAAAAAYAAAAAAAAAC8AAAADAAAAAgAAAAAAAADgA0AAAAAAAOADAAAAAAAAmwAAAAAAAAAAAAAAAAAAAAEAAAAAAAAA
      AAAAAAAAAAA3AAAA////bwIAAAAAAAAAfARAAAAAAAB8BAAAAAAAABgAAAAAAAAABAAAAAAAAAACAAAAAAAAAAIAAAAAAAAA
      RAAAAP7//28CAAAAAAAAAJgEQAAAAAAAmAQAAAAAAAAgAAAAAAAAAAUAAAABAAAACAAAAAAAAAAAAAAAAAAAAFMAAAAEAAAA
      AgAAAAAAAAC4BEAAAAAAALgEAAAAAAAAMAAAAAAAAAAEAAAAAAAAAAgAAAAAAAAAGAAAAAAAAABdAAAABAAAAEIAAAAAAAAA
      6ARAAAAAAADoBAAAAAAAAGAAAAAAAAAABAAAABUAAAAIAAAAAAAAABgAAAAAAAAAZwAAAAEAAAAGAAAAAAAAAEgFQAAAAAAA
      SAUAAAAAAAAYAAAAAAAAAAAAAAAAAAAABAAAAAAAAAAAAAAAAAAAAGIAAAABAAAABgAAAAAAAABgBUAAAAAAAGAFAAAAAAAA
      UAAAAAAAAAAAAAAAAAAAABAAAAAAAAAAEAAAAAAAAABtAAAAAQAAAAYAAAAAAAAAsAVAAAAAAACwBQAAAAAAALQCAAAAAAAA
      AAAAAAAAAAAQAAAAAAAAAAAAAAAAAAAAcwAAAAEAAAAGAAAAAAAAAGQIQAAAAAAAZAgAAAAAAAAOAAAAAAAAAAAAAAAAAAAA
      BAAAAAAAAAAAAAAAAAAAAHkAAAABAAAAAgAAAAAAAAB0CEAAAAAAAHQIAAAAAAAAKgAAAAAAAAAAAAAAAAAAAAQAAAAAAAAA
      AAAAAAAAAACBAAAAAQAAAAIAAAAAAAAAoAhAAAAAAACgCAAAAAAAACwAAAAAAAAAAAAAAAAAAAAEAAAAAAAAAAAAAAAAAAAA
      jwAAAAEAAAADAAAAAAAAAFgNYAAAAAAAWA0AAAAAAADgAAAAAAAAAAAAAAAAAAAACAAAAAAAAAAAAAAAAAAAAJkAAAABAAAA
      AwAAAAAAAAA4DmAAAAAAADgOAAAAAAAAEAAAAAAAAAAAAAAAAAAAAAgAAAAAAAAAAAAAAAAAAACgAAAAAQAAAAMAAAAAAAAA
      SA5gAAAAAABIDgAAAAAAABAAAAAAAAAAAAAAAAAAAAAIAAAAAAAAAAAAAAAAAAAApwAAAAYAAAADAAAAAAAAAFgOYAAAAAAA
      WA4AAAAAAACgAQAAAAAAAAUAAAAAAAAACAAAAAAAAAAQAAAAAAAAALAAAAABAAAAAwAAAAAAAAD4D2AAAAAAAPgPAAAAAAAA
      CAAAAAAAAAAAAAAAAAAAAAgAAAAAAAAACAAAAAAAAAC1AAAAAQAAAAMAAAAAAAAAABBgAAAAAAAAEAAAAAAAADgAAAAAAAAA
      AAAAAAAAAAAIAAAAAAAAAAgAAAAAAAAAvgAAAAEAAAADAAAAAAAAADgQYAAAAAAAOBAAAAAAAAAQAAAAAAAAAAAAAAAAAAAA
      CAAAAAAAAAAAAAAAAAAAAMQAAAAIAAAAAwAAAAAAAABIEGAAAAAAAEgQAAAAAAAAGAAAAAAAAAAAAAAAAAAAAAgAAAAAAAAA
      AAAAAAAAAAABAAAAAwAAAAAAAAAAAAAAAAAAAAAAAABIEAAAAAAAAMkAAAAAAAAAAAAAAAAAAAABAAAAAAAAAAAAAAAAAAAA
      B64EOF
      chmod +x "$CKPT"
      [ "$(sha256sum "$CKPT" | cut -d' ' -f1)" = "$CKPT_SHA" ] \
        && say "cuda-checkpoint verified" || { say "CKPT CORRUPT"; CKPT=""; }

      cat > /tmp/work.py <<'PYEOF'
      import os, time, torch
      from torch.utils.cpp_extension import load_inline

      def stamp(*a):
          print(f"[{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}] POC:", *a, flush=True)

      N = int(os.environ.get("MATDIM", "1024"))
      dev = torch.device("cuda:0")
      stamp(f"torch {torch.__version__} on {torch.cuda.get_device_name(0)}")

      # A hand-written kernel: covers the non-library path, and whether a loaded
      # module survives a checkpoint. 3*x+7 over small integers is exact in fp32.
      stamp("compiling a custom CUDA kernel with nvcc")
      mod = load_inline(
          name="poc_affine",
          cpp_sources="void affine_launch(at::Tensor x, at::Tensor y);",
          cuda_sources=r"""
      #include <torch/extension.h>
      __global__ void affine(const float* x, float* y, int n) {
        int i = blockIdx.x * blockDim.x + threadIdx.x;
        if (i < n) y[i] = 3.0f * x[i] + 7.0f;
      }
      void affine_launch(at::Tensor x, at::Tensor y) {
        int n = x.numel();
        int threads = 256, blocks = (n + threads - 1) / threads;
        affine<<<blocks, threads>>>(x.data_ptr<float>(), y.data_ptr<float>(), n);
      }
      """,
          functions=["affine_launch"], with_cuda=True, verbose=False)
      stamp("kernel compiled")

      ones = torch.ones(N, N, device=dev)
      exact_out = torch.empty(N, N, device=dev)

      g = torch.Generator(device="cuda").manual_seed(4242)
      a = torch.rand(N, N, generator=g, device=dev) - 0.5
      b = torch.rand(N, N, generator=g, device=dev) - 0.5
      # Reference computed on the CPU in float64: independent of the device under
      # test, so it cannot be corrupted by the thing being measured.
      ref = (a.cpu().double() @ b.cpu().double()).float()

      x = (torch.arange(N * N, device=dev, dtype=torch.float32) % 251)
      want_custom = 3.0 * x + 7.0
      custom_out = torch.empty_like(x)

      def check_exact():
          exact_out.zero_()
          torch.matmul(ones, ones, out=exact_out)
          torch.cuda.synchronize()
          bad = int((exact_out != float(N)).sum().item())
          return bad == 0, f"mismatched={bad}"

      def check_ref():
          c = a @ b
          torch.cuda.synchronize()
          err = (c.cpu() - ref).abs().max().item()
          return err < 1e-2, f"maxerr={err:.3e}"

      def check_custom():
          custom_out.zero_()
          mod.affine_launch(x, custom_out)
          torch.cuda.synchronize()
          bad = int((custom_out != want_custom).sum().item())
          return bad == 0, f"mismatched={bad}"

      it = 0
      while True:
          if os.path.exists("/tmp/paused"):
              stamp("paused (checkpointed)")
              time.sleep(5)
              continue
          it += 1
          e_ok, e_d = check_exact()
          r_ok, r_d = check_ref()
          c_ok, c_d = check_custom()
          verdict = "ALL PASS" if (e_ok and r_ok and c_ok) else "*** FAILURE ***"
          if it == 1 and e_ok and r_ok and c_ok:
              open("/tmp/ready", "w").close()   # only now is there a context to checkpoint
          stamp(f"round={it} exact={'ok' if e_ok else 'FAIL'}({e_d}) "
                f"ref={'ok' if r_ok else 'FAIL'}({r_d}) "
                f"custom={'ok' if c_ok else 'FAIL'}({c_d}) {verdict}")
          time.sleep(5)
      PYEOF

      say "idle ${HOLD_DELAY_SECONDS}s (golden snapshot window, GPU untouched)"
      sleep "${HOLD_DELAY_SECONDS}"

      say "starting the verification workload"
      rm -f /tmp/paused
      python3 /tmp/work.py &
      HOLDER=$!
      say "python pid $HOLDER"

      if [ -n "$CKPT" ]; then
        # Wait for the workload to prove itself on the GPU. A fixed sleep raced
        # nvcc, and checkpointing before a context exists toggles nothing while
        # still looking like it worked.
        for i in $(seq 1 120); do
          [ -f /tmp/ready ] && break
          sleep 5
        done
        [ -f /tmp/ready ] || { say "workload never reached a passing round"; sleep infinity; }
        say "workload verified on GPU; holding ${CHECKPOINT_AFTER}s before checkpoint"
        sleep "${CHECKPOINT_AFTER}"
        # /proc/*/maps, not nvidia-smi --query-compute-apps. The eject blocks on
        # the driver's usage_count, which counts open file descriptors; the smi
        # query lists CUDA context holders. They agree for one process and not
        # for a process tree, and toggling the short list looks exactly like the
        # technique failing.
        GPUPIDS=""
        for d in /proc/[0-9]*; do
          pid=${d#/proc/}
          [ "$pid" = "$$" ] && continue
          [ -r "$d/maps" ] || continue
          grep -qE '(/dev/nvidia|libcuda\.so|libcudart\.so|libnvidia-ml\.so)' "$d/maps" 2>/dev/null \
            && GPUPIDS="$GPUPIDS $pid"
        done
        say "GPU PIDs via /proc/*/maps:${GPUPIDS:- none} (launched $HOLDER)"
        [ -n "$GPUPIDS" ] || { say "NO GPU PIDS -- refusing to claim a checkpoint"; sleep infinity; }

        BEFORE_ID=$(gpu_id)
        say "CARD BEFORE: $BEFORE_ID"
        say "NODES BEFORE: $(dev_nodes)"
        touch /tmp/paused
        sleep 6
        for p in $GPUPIDS; do
          t0=$(date +%s%N)
          $CKPT --toggle --pid "$p" >/tmp/tg.log 2>&1; rc=$?
          t1=$(date +%s%N)
          say "TOGGLE pid $p rc=$rc in $(( (t1-t0)/1000000 ))ms : $(head -c 120 /tmp/tg.log | tr '\n' ' ')"
          say "state: $($CKPT --get-state --pid $p 2>&1 | head -c 40)"
        done
        say "CHECKPOINTED -- suspend now"

        # RESTORE_AFTER only has to outlast the guest's frozen window. The driver
        # rebind after re-attach lands later still, and untoggling before it does
        # fails with "Error initializing CUDA", so nvidia-smi decides when the
        # device is usable -- not a constant.
        sleep "${RESTORE_AFTER}"
        for i in $(seq 1 "$(( DEVICE_WAIT / 2 ))"); do
          nvidia-smi -L >/dev/null 2>&1 && { say "device back after $(( i * 2 ))s of polling"; break; }
          sleep 2
        done
        nvidia-smi -L >/dev/null 2>&1 || say "device STILL not usable; untoggling anyway to capture the error"

        AFTER_ID=$(gpu_id)
        say "CARD AFTER : $AFTER_ID"
        say "NODES AFTER : $(dev_nodes)"
        if [ "$BEFORE_ID" = "$AFTER_ID" ]; then
          say "VACUOUS: same card either side -- this run says NOTHING about cross-card restore"
        else
          say "CROSS-CARD: $BEFORE_ID -> $AFTER_ID"
        fi

        for p in $GPUPIDS; do
          t2=$(date +%s%N)
          $CKPT --toggle --pid "$p" >/tmp/ut.log 2>&1; rc=$?
          t3=$(date +%s%N)
          say "UNTOGGLE pid $p rc=$rc in $(( (t3-t2)/1000000 ))ms : $(head -c 120 /tmp/ut.log | tr '\n' ' ')"
        done
        rm -f /tmp/paused
        say "RESUMED -- all three checks must still pass, on the card named above"
      fi
      wait $HOLDER
  workerSelector:
    matchLabels:
      workload: poc-xcard
  snapshotsConfig:
    onPause: Full
    location: gs://BUCKET/ate-poc-kernel/
