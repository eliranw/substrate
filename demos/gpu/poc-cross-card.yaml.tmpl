# THROWAWAY -- PoC only.
#
# Does a checkpointed actor still compute correctly when it resumes on a
# DIFFERENT physical card than it suspended on?
#
# Actors resume on whichever worker is free, so this is the ordinary case as soon
# as a node has more than one device -- but every result so far was measured on a
# single-GPU node, where the actor could only ever land back on the card it left.
#
# Requires TWO devices in the pool, one per worker. Each actor still gets one:
# this is not a multi-device-per-actor test.
#
# Running it:
#   1. this manifest brings up 2 workers; the plugin gives each one device
#   2. create and resume actor x-1  -> lands on whichever worker is free
#   3. create and resume actor x-2  -> takes the other worker
#   4. suspend x-1                  -> its worker becomes free
#   5. suspend x-2 is NOT needed; instead resume x-1, which now has only the
#      other worker to land on
#
# The load-bearing assertion is the GPU UUID changing. If it does not, the actor
# landed back on the same card and the run proves nothing -- the fixture says so
# rather than reporting a pass, because a vacuous pass here is indistinguishable
# from a real one.
#
# The three correctness checks are carried over unchanged, because they fail for
# different reasons:
#   exact   ones @ ones == N                       hard equality, no tolerance
#   ref     a @ b vs an independent CPU reference   tolerance, irregular data
#   custom  a hand-written kernel via nvcc          non-library path, module survival
#
# Every output buffer is zeroed before its check, so "the kernel silently did not
# run" fails the same way "the kernel returned garbage" does.

apiVersion: v1
kind: Namespace
metadata:
  name: ate-poc-xcard

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: poc-xcard
  namespace: ate-poc-xcard
  labels:
    workload: poc-xcard
spec:
  # Two workers, one device each. The pool must land on a node with two of them;
  # a second worker that gets no device would take an actor and quietly turn the
  # cross-card test back into a same-card one.
  replicas: 2
  sandboxClass: microvm
  sandboxConfigName: microvm-gpu-poc
  ateomImage: ATEOM_IMAGE
  template:
    resources:
      requests:
        nvidia.com/GA100_A100_PCIE_40GB: "1"
      limits:
        nvidia.com/GA100_A100_PCIE_40GB: "1"

---

apiVersion: ate.dev/v1alpha1
kind: ActorTemplate
metadata:
  name: poc-xcard
  namespace: ate-poc-xcard
spec:
  sandboxClass: microvm
  containers:
  - name: torch
    image: nvcr.io/nvidia/pytorch:26.07-py3@sha256:2140e699b3beaf7f96a0081fd9c9406bc3832b435cdb60dfa2d261f7d2f34a1c
    env:
    - name: HOLD_DELAY_SECONDS
      value: "150"
    - name: CHECKPOINT_AFTER
      value: "60"
    # Guest-seconds, and only has to outlast the frozen window: the untoggle
    # waits on the device itself, not on this.
    - name: RESTORE_AFTER
      value: "60"
    # Seconds to wait for the re-attached card to answer before untoggling anyway.
    - name: DEVICE_WAIT
      value: "300"
    # Not "N": unquoted, YAML 1.1 parses that as boolean false.
    - name: MATDIM
      value: "1024"
    - name: TORCH_EXTENSIONS_DIR
      value: "/tmp/ext"
    command:
    - /bin/bash
    - -c
    - |
      set -u
      exec 2>&1
      say() { echo "[$(date -Is)] POC: $*"; }

      # The card's own identity, not the slot it sits in. A guest BDF is assigned
      # by the VMM and can repeat across cards; the UUID cannot.
      gpu_id()  { nvidia-smi --query-gpu=uuid,name --format=csv,noheader 2>&1 | tr -d ' '; }
      # Logged alongside because a re-attach that got the major/minor wrong leaves
      # nvidia-smi working while the container's device nodes point elsewhere.
      dev_nodes() { stat -c '%n=%t:%T' /dev/nvidia* 2>&1 | sort | tr '\n' ' '; }

      CKPT=/tmp/cuda-checkpoint
      CKPT_SHA=707fa7f54136824d6c1d6dd724b9b1717610f831033c00d06da474de363a06db
      base64 -d > "$CKPT" <<'B64EOF'
