      AAAAAAAAAACBAAAAAQAAAAIAAAAAAAAAoAhAAAAAAACgCAAAAAAAACwAAAAAAAAAAAAAAAAAAAAEAAAAAAAAAAAAAAAAAAAA
      jwAAAAEAAAADAAAAAAAAAFgNYAAAAAAAWA0AAAAAAADgAAAAAAAAAAAAAAAAAAAACAAAAAAAAAAAAAAAAAAAAJkAAAABAAAA
      AwAAAAAAAAA4DmAAAAAAADgOAAAAAAAAEAAAAAAAAAAAAAAAAAAAAAgAAAAAAAAAAAAAAAAAAACgAAAAAQAAAAMAAAAAAAAA
      SA5gAAAAAABIDgAAAAAAABAAAAAAAAAAAAAAAAAAAAAIAAAAAAAAAAAAAAAAAAAApwAAAAYAAAADAAAAAAAAAFgOYAAAAAAA
      WA4AAAAAAACgAQAAAAAAAAUAAAAAAAAACAAAAAAAAAAQAAAAAAAAALAAAAABAAAAAwAAAAAAAAD4D2AAAAAAAPgPAAAAAAAA
      CAAAAAAAAAAAAAAAAAAAAAgAAAAAAAAACAAAAAAAAAC1AAAAAQAAAAMAAAAAAAAAABBgAAAAAAAAEAAAAAAAADgAAAAAAAAA
      AAAAAAAAAAAIAAAAAAAAAAgAAAAAAAAAvgAAAAEAAAADAAAAAAAAADgQYAAAAAAAOBAAAAAAAAAQAAAAAAAAAAAAAAAAAAAA
      CAAAAAAAAAAAAAAAAAAAAMQAAAAIAAAAAwAAAAAAAABIEGAAAAAAAEgQAAAAAAAAGAAAAAAAAAAAAAAAAAAAAAgAAAAAAAAA
      AAAAAAAAAAABAAAAAwAAAAAAAAAAAAAAAAAAAAAAAABIEAAAAAAAAMkAAAAAAAAAAAAAAAAAAAABAAAAAAAAAAAAAAAAAAAA
      B64EOF
      chmod +x "$CKPT"
      got=$(sha256sum "$CKPT" | cut -d' ' -f1)
      if [ "$got" = "$CKPT_SHA" ]; then
        say "cuda-checkpoint EMBEDDED and VERIFIED, $(stat -c%s "$CKPT") bytes"
        "$CKPT" --help >/tmp/ckpt-help 2>&1
        say "cuda-checkpoint --help exit=$? : $(head -c 240 /tmp/ckpt-help | tr '\n' ' ')"
      else
        say "EMBED CORRUPT: got ${got:0:16} want ${CKPT_SHA:0:16}"
        CKPT=""
      fi

      say "idle phase: ${HOLD_DELAY_SECONDS}s before opening a context"
      say "(the golden snapshot is taken during this window, against an idle GPU)"
      n=0
      while [ "$n" -lt "$HOLD_DELAY_SECONDS" ]; do
        nvidia-smi --query-gpu=name,driver_version --format=csv,noheader 2>&1 | sed "s/^/[$(date -Is)] POC: idle /"
        sleep 10
        n=$((n+10))
      done

      say "opening CUDA context now -- suspend is expected to FAIL from here"
      rm -f /tmp/paused
      /tmp/holder &
      HOLDER=$!
      say "holder pid $HOLDER"

      # There is no exec into an actor, so the checkpoint has to be self-timed.
      # After CHECKPOINT_AFTER seconds of holding the device, drop the CUDA
      # state and release the GPU -- then a suspend attempt answers the spike.
      if [ -n "$CKPT" ]; then
        sleep "${CHECKPOINT_AFTER}"
        say "state before: $($CKPT --get-state --pid $HOLDER 2>&1 | head -c 120)"
        touch /tmp/paused
        sleep 2
        t0=$(date +%s.%N)
        $CKPT --toggle --pid $HOLDER >/tmp/toggle.log 2>&1
        rc=$?
        t1=$(date +%s.%N)
        say "TOGGLE rc=$rc in $(echo "$t1 - $t0" | bc)s : $(head -c 200 /tmp/toggle.log | tr '\n' ' ')"
        say "state after : $($CKPT --get-state --pid $HOLDER 2>&1 | head -c 120)"
        say "CHECKPOINTED -- suspend should now be able to eject the GPU"

        # Guest time stops while suspended, so this sleep spans the whole
        # suspend/restore cycle and fires once the actor is running again.
        sleep "${RESTORE_AFTER}"
        say "toggling back; state now: $($CKPT --get-state --pid $HOLDER 2>&1 | head -c 80)"
        t0=$(date +%s.%N)
        $CKPT --toggle --pid $HOLDER >/tmp/untoggle.log 2>&1
        rc=$?
        t1=$(date +%s.%N)
        say "UNTOGGLE rc=$rc in $(echo "$t1 - $t0" | bc)s : $(head -c 200 /tmp/untoggle.log | tr '\n' ' ')"
        say "state after : $($CKPT --get-state --pid $HOLDER 2>&1 | head -c 80)"
        rm -f /tmp/paused
        say "RESUMED -- the holder should now read VRAM again; watch integrity"
      else
        say "no cuda-checkpoint binary; staying held"
      fi
      wait $HOLDER
  workerSelector:
    matchLabels:
      workload: poc-cudackpt
  snapshotsConfig:
    onPause: Full
    location: gs://${BUCKET_NAME}/ate-poc-cudackpt/
