# THROWAWAY -- proof of concept only, not part of the product.
#
# Answers one question: does a cuda-checkpoint'd process release the nvidia
# driver's reference count far enough for the ACPI eject to complete, so an
# actor with a live CUDA context can be suspended?
#
# The stock GPU fixture (demos/gpu/gpu-microvm.yaml.tmpl) cannot answer it. It
# runs nvidia-smi in a loop, which opens and closes the device in well under a
# second, so it never holds a context -- which is why suspend already works
# there. That is an instance of the "idle GPUs only" limitation, not a
# counter-example to it.
#
# This workload holds a context for as long as it runs, and holds device memory
# with a known pattern in it, so a checkpoint/restore cycle can be checked for
# integrity rather than just liveness.
#
# The context is opened only after HOLD_DELAY_SECONDS. The golden snapshot is
# taken shortly after the pool warms up, and a golden snapshot of a process
# holding a context would fail to detach -- leaving the pool with no snapshot to
# create actors from. The delay lets the warmup snapshot happen against an idle
# GPU, which is exactly the case that already works.

apiVersion: v1
kind: Namespace
metadata:
  name: ate-poc-cudackpt

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: poc-cudackpt
  namespace: ate-poc-cudackpt
  labels:
    workload: poc-cudackpt
spec:
  replicas: 1
  sandboxClass: microvm
  sandboxConfigName: microvm-gpu
  ateomImage: ko://github.com/agent-substrate/substrate/cmd/ateom-microvm
  template:
    resources:
      requests:
        nvidia.com/GA100_A100_PCIE_40GB: "1"
      limits:
        nvidia.com/GA100_A100_PCIE_40GB: "1"

---

apiVersion: ate.dev/v1alpha1
kind: ActorTemplate
metadata:
  name: poc-cudackpt
  namespace: ate-poc-cudackpt
spec:
  sandboxClass: microvm
  containers:
  - name: cuda
    # devel rather than base: this needs a C compiler to build the context
    # holder. Image size does not reach the snapshot -- the layers are a
    # virtio-fs mount served from the host, not guest RAM.
    image: nvcr.io/nvidia/cuda:12.6.2-devel-ubuntu24.04@sha256:738fba0fbdb225b7a2931c58a5c8f03a84d3cd2f6a84975826a157339ef750b8
    env:
    - name: HOLD_DELAY_SECONDS
      value: "90"
    # Device memory to hold, in MiB. Small on purpose: the guest has 2048 MiB
    # and a checkpoint has to drain VRAM into guest RAM, so this bounds what a
    # working checkpoint would have to move.
    - name: HOLD_MIB
      value: "64"
    # Seconds to hold the device before checkpointing. Long enough to confirm
    # the context is live and that suspend fails, short enough not to wait.
    - name: CHECKPOINT_AFTER
      value: "120"
    # Guest seconds to stay checkpointed. The clock freezes while suspended, so
    # this is a window in guest time for the suspend/resume to happen inside.
    - name: RESTORE_AFTER
      value: "420"
    command:
    - /bin/bash
    - -c
    - |
      set -u
      exec 2>&1
      say() { echo "[$(date -Is)] POC: $*"; }

      # libcuda comes from the guest driver via CDI injection, not from the
      # image, so it is opened with dlopen at runtime rather than linked.
      cat > /tmp/holder.c <<'CEOF'
      #include <stdio.h>
      #include <stdlib.h>
      #include <string.h>
      #include <unistd.h>
      #include <time.h>
      #include <dlfcn.h>

      typedef int (*fn_init)(unsigned);
      typedef int (*fn_devget)(int *, int);
      typedef int (*fn_devname)(char *, int, int);
      typedef int (*fn_ctxcreate)(void **, unsigned, int);
      typedef int (*fn_alloc)(unsigned long long *, size_t);
      typedef int (*fn_h2d)(unsigned long long, const void *, size_t);
      typedef int (*fn_d2h)(void *, unsigned long long, size_t);

      static void stamp(void) {
        char b[64];
        time_t t = time(NULL);
        struct tm tm;
        gmtime_r(&t, &tm);
        strftime(b, sizeof b, "%Y-%m-%dT%H:%M:%SZ", &tm);
        printf("[%s] POC: ", b);
      }

      int main(void) {
        setvbuf(stdout, NULL, _IONBF, 0);
        size_t mib = (size_t)atoi(getenv("HOLD_MIB") ? getenv("HOLD_MIB") : "64");
        size_t bytes = mib * 1024 * 1024;

        void *h = dlopen("libcuda.so.1", RTLD_NOW);
        if (!h) { stamp(); printf("dlopen libcuda.so.1 FAILED: %s\n", dlerror()); return 10; }

        fn_init      cuInit      = (fn_init)     dlsym(h, "cuInit");
        fn_devget    cuDeviceGet = (fn_devget)   dlsym(h, "cuDeviceGet");
        fn_devname   cuDevName   = (fn_devname)  dlsym(h, "cuDeviceGetName");
        fn_ctxcreate cuCtxCreate = (fn_ctxcreate)dlsym(h, "cuCtxCreate_v2");
        fn_alloc     cuMemAlloc  = (fn_alloc)    dlsym(h, "cuMemAlloc_v2");
        fn_h2d       cuH2D       = (fn_h2d)      dlsym(h, "cuMemcpyHtoD_v2");
        fn_d2h       cuD2H       = (fn_d2h)      dlsym(h, "cuMemcpyDtoH_v2");
        if (!cuInit || !cuDeviceGet || !cuCtxCreate || !cuMemAlloc || !cuH2D || !cuD2H) {
          stamp(); printf("dlsym FAILED (driver API symbols missing)\n"); return 11;
        }

        int rc = cuInit(0);
        if (rc) { stamp(); printf("cuInit FAILED rc=%d\n", rc); return 12; }

        int dev = 0;
        rc = cuDeviceGet(&dev, 0);
        if (rc) { stamp(); printf("cuDeviceGet FAILED rc=%d\n", rc); return 13; }

        char name[256] = {0};
        if (cuDevName) cuDevName(name, sizeof name, dev);

        void *ctx = NULL;
        rc = cuCtxCreate(&ctx, 0, dev);
        if (rc) { stamp(); printf("cuCtxCreate FAILED rc=%d\n", rc); return 14; }
        stamp(); printf("CONTEXT OPEN on '%s' -- the device is now held\n", name);

        unsigned long long dptr = 0;
        rc = cuMemAlloc(&dptr, bytes);
        if (rc) { stamp(); printf("cuMemAlloc(%zu MiB) FAILED rc=%d\n", mib, rc); return 15; }

        // A pattern that is cheap to verify: byte i = i*31+7 over the first
        // page, zero elsewhere. Only the head is read back each tick.
        unsigned char *host = malloc(4096);
        for (int i = 0; i < 4096; i++) host[i] = (unsigned char)(i * 31 + 7);
        rc = cuH2D(dptr, host, 4096);
        if (rc) { stamp(); printf("cuMemcpyHtoD FAILED rc=%d\n", rc); return 16; }
        stamp(); printf("VRAM HELD %zu MiB, pattern written\n", mib);

        unsigned char back[16];
        for (;;) {
          // While checkpointed the process must make no CUDA calls; the wrapper
          // raises this flag around the toggle.
          if (access("/tmp/paused", F_OK) == 0) {
            stamp(); printf("holder idle (checkpointed)\n");
            sleep(5); continue;
          }
          memset(back, 0, sizeof back);
          rc = cuD2H(back, dptr, sizeof back);
          stamp();
          if (rc) {
            printf("VRAM READBACK FAILED rc=%d  <-- context is broken\n", rc);
          } else {
            int ok = 1;
            for (int i = 0; i < 16; i++)
              if (back[i] != (unsigned char)(i * 31 + 7)) ok = 0;
            printf("ctx alive, vram head=%02x%02x%02x%02x integrity=%s\n",
                   back[0], back[1], back[2], back[3], ok ? "OK" : "CORRUPT");
          }
          sleep(5);
        }
      }
      CEOF

      say "compiling context holder"
      gcc -O0 -o /tmp/holder /tmp/holder.c -ldl || { say "COMPILE FAILED"; sleep infinity; }
      say "compiled"

      # Fetched here rather than staged as a SandboxConfig asset: assets land on
      # the host and this has to run inside the container, which would need an
      # ateom change to bridge. Fine for a PoC, wrong for production.
      CKPT=/tmp/cuda-checkpoint
      CKPT_SHA=707fa7f54136824d6c1d6dd724b9b1717610f831033c00d06da474de363a06db

      # Embedded rather than fetched. The image has no curl and openssl
      # s_client mangles a binary stream, so the network was costing more than
      # it was worth for 6KB. A real implementation would stage this as a
      # SandboxConfig asset and bind-mount it in.
