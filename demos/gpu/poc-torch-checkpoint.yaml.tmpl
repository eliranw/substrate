      chmod +x "$CKPT"
      [ "$(sha256sum "$CKPT" | cut -d' ' -f1)" = "$CKPT_SHA" ] \
        && say "cuda-checkpoint verified" || { say "CKPT CORRUPT"; CKPT=""; }

      cat > /tmp/work.py <<'PYEOF'
      import os, time, hashlib, torch

      def stamp(*a):
          print(f"[{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}] POC:", *a, flush=True)

      mib = int(os.environ.get("TENSOR_MIB", "512"))
      dev = torch.device("cuda:0")
      stamp(f"torch {torch.__version__} on {torch.cuda.get_device_name(0)}")

      # A tensor that must survive the cycle unchanged. Deterministic contents so
      # the digest can be recomputed and compared, not merely remembered.
      n = (mib * 1024 * 1024) // 4
      g = torch.Generator(device="cuda").manual_seed(1234)
      keep = torch.rand(n, generator=g, device=dev, dtype=torch.float32)
      want = hashlib.sha256(keep.cpu().numpy().tobytes()).hexdigest()[:16]
      stamp(f"persistent tensor {mib} MiB, digest {want}")

      # Real work on a non-default stream: cuBLAS matmuls, allocator churn.
      stream = torch.cuda.Stream()
      a = torch.randn(2048, 2048, device=dev)
      b = torch.randn(2048, 2048, device=dev)
      it = 0
      while True:
          if os.path.exists("/tmp/paused"):
              stamp("paused (checkpointed)")
              time.sleep(5)
              continue
          with torch.cuda.stream(stream):
              for _ in range(20):
                  c = a @ b
                  a = torch.tanh(c) * 0.01 + a * 0.99
          torch.cuda.synchronize()
          it += 20
          got = hashlib.sha256(keep.cpu().numpy().tobytes()).hexdigest()[:16]
          ok = "OK" if got == want else f"CORRUPT got={got}"
          mem = torch.cuda.memory_allocated() / 2**20
          stamp(f"matmuls={it} allocated={mem:.0f}MiB digest={got} integrity={ok}")
          time.sleep(5)
      PYEOF

      say "idle ${HOLD_DELAY_SECONDS}s (golden snapshot window, GPU untouched)"
      nvidia-smi --query-gpu=name,driver_version --format=csv,noheader 2>&1 | sed "s/^/[$(date -Is)] POC: idle /"
      sleep "${HOLD_DELAY_SECONDS}"

      say "starting the PyTorch workload"
      rm -f /tmp/paused
      python3 /tmp/work.py &
      HOLDER=$!
      say "python pid $HOLDER"

      if [ -n "$CKPT" ]; then
        sleep "${CHECKPOINT_AFTER}"
        say "state before: $($CKPT --get-state --pid $HOLDER 2>&1 | head -c 100)"
        touch /tmp/paused
        sleep 8
        t0=$(date +%s.%N)
        $CKPT --toggle --pid $HOLDER >/tmp/toggle.log 2>&1; rc=$?
        t1=$(date +%s.%N)
        say "TOGGLE rc=$rc in $(echo "$t1 - $t0" | bc)s : $(head -c 200 /tmp/toggle.log | tr '\n' ' ')"
        say "state after : $($CKPT --get-state --pid $HOLDER 2>&1 | head -c 100)"
        say "CHECKPOINTED -- suspend should now succeed"

        sleep "${RESTORE_AFTER}"
        say "toggling back; state: $($CKPT --get-state --pid $HOLDER 2>&1 | head -c 80)"
        t2=$(date +%s.%N)
        $CKPT --toggle --pid $HOLDER >/tmp/untoggle.log 2>&1; rc=$?
        t3=$(date +%s.%N)
        say "UNTOGGLE rc=$rc in $(echo "$t3 - $t2" | bc)s : $(head -c 200 /tmp/untoggle.log | tr '\n' ' ')"
        rm -f /tmp/paused
        say "RESUMED -- matmuls and digest should continue"
      fi
      wait $HOLDER
  workerSelector:
    matchLabels:
      workload: poc-torch
  snapshotsConfig:
    onPause: Full
    location: gs://BUCKET/ate-poc-torch/
