# THROWAWAY -- PoC only.
#
# Does the cuda-checkpoint result hold for real compute? The earlier fixture
# held a bare driver context with one allocation and never launched a kernel.
# This one runs PyTorch: the caching allocator, cuBLAS matmuls on a non-default
# stream, and a checksummed tensor that must survive the cycle byte-for-byte.
#
# Needs microvm-gpu-poc (8192 MiB guest). PyTorch's own RSS exceeds the stock
# 2048 MiB before it allocates anything on the device.

apiVersion: v1
kind: Namespace
metadata:
  name: ate-poc-torch

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: poc-torch
  namespace: ate-poc-torch
  labels:
    workload: poc-torch
spec:
  replicas: 1
  sandboxClass: microvm
  sandboxConfigName: microvm-gpu-poc
  ateomImage: ATEOM_IMAGE
  template:
    resources:
      requests:
        nvidia.com/GA100_A100_PCIE_40GB: "1"
      limits:
        nvidia.com/GA100_A100_PCIE_40GB: "1"

---

apiVersion: ate.dev/v1alpha1
kind: ActorTemplate
metadata:
  name: poc-torch
  namespace: ate-poc-torch
spec:
  sandboxClass: microvm
  containers:
  - name: torch
    image: nvcr.io/nvidia/pytorch:26.07-py3@sha256:2140e699b3beaf7f96a0081fd9c9406bc3832b435cdb60dfa2d261f7d2f34a1c
    env:
    - name: HOLD_DELAY_SECONDS
      value: "120"
    - name: CHECKPOINT_AFTER
      value: "150"
    - name: RESTORE_AFTER
      value: "420"
    # Device memory for the persistent checksummed tensor, in MiB. A checkpoint
    # drains this into guest RAM, so it is bounded by the 8192 MiB guest.
    - name: TENSOR_MIB
      value: "512"
    command:
    - /bin/bash
    - -c
    - |
      set -u
      exec 2>&1
      say() { echo "[$(date -Is)] POC: $*"; }

      CKPT=/tmp/cuda-checkpoint
