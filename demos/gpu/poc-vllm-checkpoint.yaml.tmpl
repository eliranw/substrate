      B64EOF
      chmod +x "$CKPT"
      [ "$(sha256sum "$CKPT" | cut -d' ' -f1)" = "$CKPT_SHA" ] \
        && say "cuda-checkpoint verified" || { say "CKPT CORRUPT"; CKPT=""; }

      # A tiny stdlib client: the image has python but the point is to avoid
      # depending on anything that might be missing, as curl was.
      cat > /tmp/ask.py <<'PYEOF'
      import json, sys, urllib.request
      prompt = sys.argv[1]
      body = json.dumps({
          "model": __import__("os").environ.get("MODEL", "facebook/opt-125m"),
          "prompt": prompt,
          "max_tokens": 48,
          "temperature": 0,      # greedy: deterministic, so before==after is a string compare
          "seed": 1234,
      }).encode()
      req = urllib.request.Request("http://127.0.0.1:8000/v1/completions",
                                   data=body, headers={"Content-Type": "application/json"})
      with urllib.request.urlopen(req, timeout=120) as r:
          out = json.load(r)
      print(out["choices"][0]["text"].replace("\n", " ").strip())
      PYEOF

      cat > /tmp/fetch.py <<'FETCHEOF'
      import os, sys, time, urllib.request
      host = os.environ["MODEL_HOST"]
      files = ["config.json", "generation_config.json", "merges.txt",
               "pytorch_model.bin", "special_tokens_map.json",
               "tokenizer_config.json", "vocab.json"]
      os.makedirs("/tmp/model", exist_ok=True)
      t0 = time.time()
      total = 0
      for f in files:
          url = f"http://{host}/opt-125m/{f}"
          try:
              with urllib.request.urlopen(url, timeout=60) as r:
                  data = r.read()
          except Exception as e:
              print(f"FETCH FAILED {f}: {type(e).__name__}: {e}", flush=True)
              sys.exit(1)
          open(f"/tmp/model/{f}", "wb").write(data)
          total += len(data)
          print(f"  fetched {f} {len(data):,}B", flush=True)
      print(f"MODEL READY {total:,} bytes in {time.time()-t0:.1f}s", flush=True)
      FETCHEOF

      say "fetching the model from $MODEL_HOST"
      python3 /tmp/fetch.py 2>&1 | sed "s/^/[$(date -Is)] POC: /"
      if [ ! -s /tmp/model/config.json ]; then
        say "MODEL FETCH FAILED -- cannot continue"; sleep infinity
      fi

      say "idle ${HOLD_DELAY_SECONDS}s (golden snapshot window, GPU untouched)"
      sleep "${HOLD_DELAY_SECONDS}"

      say "starting vLLM: $MODEL at gpu_memory_utilization=$GPU_MEM_UTIL"
      vllm serve "$MODEL" --port 8000 --host 127.0.0.1 \
        --gpu-memory-utilization "$GPU_MEM_UTIL" --max-model-len 2048 \
        > /tmp/vllm.log 2>&1 &
      SERVER=$!
      # Forward the interesting lines: there is no exec into an actor, so a log
      # that only lives in the guest is a log nobody can read.
      ( tail -F /tmp/vllm.log 2>/dev/null \
          | grep --line-buffered -E 'Error|error|Traceback|OSError|Cannot|Failed|Loading|loaded|KV cache|Capturing|init engine|Starting' \
          | sed "s/^/[vllm] /" ) &

      for i in $(seq 1 90); do
        if python3 -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/health',timeout=3)" 2>/dev/null; then
          say "vLLM healthy after ${i}0s"; break
        fi
        sleep 10
      done
      python3 -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/health',timeout=3)" 2>/dev/null \
        || { say "vLLM NEVER CAME UP: $(tail -c 400 /tmp/vllm.log | tr '\n' ' ')"; sleep infinity; }

      # vLLM runs its engine in a child process, so the PID holding the CUDA
      # context is not the one we launched. Two ways to ask who is using the
      # GPU, and they do not have to agree:
      #
      #   nvidia-smi --query-compute-apps  who the driver counts as a compute
      #                                    app, i.e. who holds a CUDA context
      #   /proc/<pid>/maps                 who has the device or the driver
      #                                    libraries mapped at all
      #
      # The eject blocks on the driver's usage_count, which counts open file
      # descriptors -- so the second list is the one that matches the
      # constraint. For a single process the two coincide; for a process tree
      # they need not.
      SMIPIDS=$(nvidia-smi --query-compute-apps=pid --format=csv,noheader | tr -d ' ' | tr '\n' ' ')
      MAPPIDS=""
      for d in /proc/[0-9]*; do
        pid=${d#/proc/}
        [ "$pid" = "$$" ] && continue
        [ -r "$d/maps" ] || continue
        grep -qE '(/dev/nvidia|libcuda\.so|libcudart\.so|libnvidia-ml\.so)' "$d/maps" 2>/dev/null \
          && MAPPIDS="$MAPPIDS $pid"
      done
      say "PIDS via nvidia-smi   :${SMIPIDS:+ }${SMIPIDS:-none}"
      say "PIDS via /proc/*/maps :${MAPPIDS:- none}"
      for p in $MAPPIDS; do
        say "  pid $p  $(tr '\0' ' ' < /proc/$p/cmdline 2>/dev/null | head -c 90)"
      done

      # Toggle the /proc-derived list: it is a superset, and a process that has
      # libcuda mapped without ever creating a context simply reports an
      # initialization error, which is logged and skipped rather than fatal.
      GPUPIDS="$MAPPIDS"

      PROMPT="The capital of France is"
      BEFORE=$(python3 /tmp/ask.py "$PROMPT")
      say "BEFORE: $BEFORE"

      # A long prompt so the KV cache holds something worth losing.
      LONG=$(python3 -c "print('The quick brown fox jumps over the lazy dog. ' * 40)")
      python3 /tmp/ask.py "$LONG" > /tmp/long_before.txt 2>&1
      say "KV warm: $(head -c 90 /tmp/long_before.txt)"

      if [ -n "$CKPT" ] && [ -n "$GPUPIDS" ]; then
        sleep "${CHECKPOINT_AFTER}"
        for p in $GPUPIDS; do
          say "state before pid $p: $($CKPT --get-state --pid $p 2>&1 | head -c 60)"
        done
        t0=$(date +%s%N)
        for p in $GPUPIDS; do
          $CKPT --toggle --pid "$p" >/tmp/tg.$p.log 2>&1; rc=$?
          say "TOGGLE pid $p rc=$rc : $(head -c 140 /tmp/tg.$p.log | tr '\n' ' ')"
        done
        t1=$(date +%s%N)
        say "toggle total $(( (t1-t0)/1000000 ))ms"
        for p in $GPUPIDS; do
          say "state after pid $p: $($CKPT --get-state --pid $p 2>&1 | head -c 60)"
        done
        say "CHECKPOINTED -- suspend should now succeed"

        sleep "${RESTORE_AFTER}"
        t2=$(date +%s%N)
        for p in $GPUPIDS; do
          $CKPT --toggle --pid "$p" >/tmp/ut.$p.log 2>&1; rc=$?
          say "UNTOGGLE pid $p rc=$rc : $(head -c 140 /tmp/ut.$p.log | tr '\n' ' ')"
        done
        t3=$(date +%s%N)
        say "untoggle total $(( (t3-t2)/1000000 ))ms"

        sleep 10
        AFTER=$(python3 /tmp/ask.py "$PROMPT" 2>&1)
        say "AFTER : $AFTER"
        if [ "$BEFORE" = "$AFTER" ]; then
          say "VERDICT: IDENTICAL -- greedy output matches across the cycle"
        else
          say "VERDICT: DIFFERENT"
          say "  before: $BEFORE"
          say "  after : $AFTER"
        fi
        python3 /tmp/ask.py "$LONG" > /tmp/long_after.txt 2>&1
        if diff -q /tmp/long_before.txt /tmp/long_after.txt >/dev/null; then
          say "VERDICT: long-prompt output also identical"
        else
          say "VERDICT: long-prompt output DIFFERS"
        fi
      fi
      wait $SERVER
  workerSelector:
    matchLabels:
      workload: poc-vllm
  snapshotsConfig:
    onPause: Full
    location: gs://BUCKET/ate-poc-vllm/
