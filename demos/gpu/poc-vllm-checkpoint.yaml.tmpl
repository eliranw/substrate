# THROWAWAY -- PoC only.
#
# Does a served LLM survive suspend/resume with the GPU physically ejected?
#
# Stronger than the synthetic fixtures: greedy decoding on a fixed prompt is
# deterministic, so before/after is a string comparison -- no float tolerance,
# no digest fragility, and a wrong answer is readable rather than a flag. It
# also exercises a large paged KV cache, PagedAttention kernels, a scheduler
# and CUDA graphs, none of which a@b touches.
#
# Needs microvm-gpu-vllm (16384 MiB guest): a checkpoint drains the KV cache
# into guest RAM, so the guest must be larger than the cache.

apiVersion: v1
kind: Namespace
metadata:
  name: ate-poc-vllm

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: poc-vllm
  namespace: ate-poc-vllm
  labels:
    workload: poc-vllm
spec:
  replicas: 1
  sandboxClass: microvm
  sandboxConfigName: microvm-gpu-vllm
  ateomImage: ATEOM_IMAGE
  template:
    resources:
      requests:
        nvidia.com/GA100_A100_PCIE_40GB: "1"
      limits:
        nvidia.com/GA100_A100_PCIE_40GB: "1"

---

apiVersion: ate.dev/v1alpha1
kind: ActorTemplate
metadata:
  name: poc-vllm-v5
  namespace: ate-poc-vllm
spec:
  sandboxClass: microvm
  containers:
  - name: vllm
    image: nvcr.io/nvidia/vllm:26.07-py3@sha256:95c498a475142c20c989c65e5d223348c09fed83ba17ddf44f117610c0bd3268
    env:
    - name: HOLD_DELAY_SECONDS
      value: "150"
    - name: CHECKPOINT_AFTER
      value: "120"
    - name: RESTORE_AFTER
      value: "2400"
    - name: MODEL
      value: "/tmp/model"
    # In-cluster plain HTTP, so the fixture has no external dependency and no
    # SigV4 or TLS to get wrong. It also exercises a ClusterIP from inside an
    # actor, which works because the egress path dials IP:port straight from
    # the CONNECT authority.
    - name: MODEL_HOST
      value: "10.102.148.70:8080"
    # Fraction of the 40 GB card vLLM may use. A checkpoint drains all of it
    # into the 16 GB guest, so this is bounded by guest RAM, not by the card.
    - name: GPU_MEM_UTIL
      value: "0.10"
    - name: HF_HOME
      value: "/tmp/hf"
    command:
    - /bin/bash
    - -c
    - |
      set -u
      exec 2>&1
      say() { echo "[$(date -Is)] POC: $*"; }

      CKPT=/tmp/cuda-checkpoint
      CKPT_SHA=707fa7f54136824d6c1d6dd724b9b1717610f831033c00d06da474de363a06db
